# Velocity backend config — copy to .env and adjust. LOCAL DEV ONLY.
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgres://velo:velo@localhost:5544/velo

# Our own JWT signing secret — change this.
JWT_SECRET=change-me
JWT_TTL=7d

# DEV_AUTH enables POST /auth/dev (local stand-in for Apple/Google sign-in).
DEV_AUTH=true
# DEV_AUTO_MODERATE approves community edits instantly so the reward loop is demoable.
DEV_AUTO_MODERATE=true

# Anti-abuse (PTS-3) and report lifetime (REP-3)
DAILY_XP_CAP=500
REPORT_TTL_DAYS=14

# External providers — leave blank to use the built-in offline fallbacks.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
PHOTON_URL=

# Uploads (local disk), served from PUBLIC_BASE_URL/uploads/*
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8787

# Apple / Google verification (structure only; unused while DEV_AUTH=true)
APPLE_BUNDLE_ID=com.velocity.app
GOOGLE_CLIENT_ID=
